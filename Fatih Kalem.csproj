<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Fatih Kalem</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>False</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
    <NoWarn>CS0168;CS0219;CS0162;CS0164</NoWarn>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!-- WPF BAML resource - embedded as Resource so WPF can find it in the standard .g.resources -->
  <ItemGroup>
    <Resource Include="mainwindow.baml" />
  </ItemGroup>

  <!-- Image resources embedded in assembly -->
  <ItemGroup>
    <Resource Include="resources\*.png" />
    <Resource Include="resources\*.ico" />
    <Resource Include="splashscreen1.png" />
  </ItemGroup>

  <!-- VB.NET runtime reference -->
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>
</Project>
